# ═══════════════════════════════════════════════════════════════════════════
# NGINX config TEMPLATE.
#
# Mounted at /etc/nginx/templates/nginx.conf.template; the official nginx image
# runs envsubst over it at container start and writes /etc/nginx/nginx.conf
# (NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx in docker-compose.yml). Only variables
# that are actually exported are substituted, so nginx's own $host / $scheme /
# $remote_addr are left alone.
#
# ${DOMAIN} is the only thing that changes when the site moves domains - it is
# required by docker-compose.yml, and the certbot service issues/renews the
# certificate for the same value.
# ═══════════════════════════════════════════════════════════════════════════

events {
    worker_connections 2048;
    multi_accept on;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    # ── Basic Performance ──────────────────────────────────────────────────────
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout  65;
    types_hash_max_size 2048;
    server_tokens off;
    client_max_body_size 20M;

    # ── Real IP (trust Cloudflare / upstream proxy headers) ────────────────────
    # Without this, all clients share the Docker-bridge IP (172.18.0.x)
    # and a single user retrying login exhausts the rate-limit for everyone.
    real_ip_header    CF-Connecting-IP;
    real_ip_recursive on;
    set_real_ip_from  172.16.0.0/12;   # Docker internal networks
    set_real_ip_from  10.0.0.0/8;
    set_real_ip_from  192.168.0.0/16;
    # Cloudflare IPv4 ranges
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    # Cloudflare IPv6 ranges
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;

    # ── Logging ────────────────────────────────────────────────────────────────
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent"';
    access_log /var/log/nginx/access.log main;
    error_log  /var/log/nginx/error.log warn;

    # ── Gzip Compression ───────────────────────────────────────────────────────
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # ── Rate Limiting ──────────────────────────────────────────────────────────
    # Tiered by real cost: dropdown lookups are cheap (Redis-cached as of the
    # oil-finder caching change) and get a generous ceiling; vehicle/spec lookups
    # hit the DB/matching logic on every call (not_found/ambiguous results are
    # never cached, by design) and get the tightest non-auth ceiling.
    limit_req_zone $binary_remote_addr zone=api_limit:10m  rate=20r/s;
    limit_req_zone $binary_remote_addr zone=oilfinder_dropdown_limit:10m rate=10r/s;
    limit_req_zone $binary_remote_addr zone=oilfinder_lookup_limit:10m rate=3r/s;
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;
    # 20r/m matches the backend's own @Throttle on ChatController - was 5r/m,
    # which a normal back-and-forth conversation could trip in well under a
    # minute (reported as "the AI bot not working": requests past the 6th in
    # a minute silently got a 429, and the frontend shows a generic error
    # without surfacing why).
    limit_req_zone $binary_remote_addr zone=chat_limit:10m rate=20r/m;
    limit_req_zone $binary_remote_addr zone=site_limit:10m rate=20r/s;

    # ── Connection Limiting ─────────────────────────────────────────────────────
    # Caps simultaneous open connections per IP — blunts request-flood / naive
    # DDoS-style traffic that opens many connections rather than many requests.
    limit_conn_zone $binary_remote_addr zone=conn_limit:10m;
    limit_req_status 429;
    limit_conn_status 429;

    # ── Known bad bots / scrapers ───────────────────────────────────────────────
    # Blocks common scraping/HTTP-library User-Agents and empty UAs.
    # Deliberately does NOT block legitimate search-engine crawlers (Googlebot,
    # Bingbot, etc.) so SEO indexing keeps working.
    map $http_user_agent $is_bad_bot {
        default 0;
        ""      1;
        "~*(?:curl|wget|python-requests|scrapy|libwww-perl|go-http-client|java/|okhttp|axios/|node-fetch)" 1;
        "~*(?:ahrefsbot|semrushbot|mj12bot|dotbot|petalbot|zoominfobot)" 1;
    }

    # DNS Resolver for Docker dynamically resolving IP addresses to avoid 502 Bad Gateway
    resolver 127.0.0.11 valid=10s ipv6=off;

    # ── WebP negotiation for /uploads/ ─────────────────────────────────────────
    map $http_accept $webp_suffix {
        default          "";
        "~*image/webp"   ".webp";
    }

    # ── HTTP Server (Port 80) -> Redirect to HTTPS ────────────────────────────
    server {
        # default_server: requests with an unrecognised Host (including the
        # internal `Host: nginx:8082` used for SSR) must still land here.
        listen 80 default_server;
        server_name ${DOMAIN} www.${DOMAIN};

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # ── HTTPS Main Server (Port 443 & Port 8082) ───────────────────────────────
    server {
        listen 443 ssl default_server;
        listen 8082 default_server;
        server_name ${DOMAIN} www.${DOMAIN};

        ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 10m;

        set $backend "backend:4000";
        set $frontend "frontend:3000";

        # ── Security Headers ───────────────────────────────────────────────────
        # Per-response headers (CSP, X-Frame-Options, ...) stay authoritative in
        # Next.js middleware (frontend) and Helmet (backend) so they are not
        # duplicated. HSTS is set here too because locations served directly by
        # nginx - /uploads/, /storage/, /_next/static/ - never pass through
        # either, and `always` keeps it on error responses.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        # ── Anti-Bot / Flood Baseline ──────────────────────────────────────────
        # Caps simultaneous connections per IP (blunts connection-flood/DDoS-style
        # traffic) and drops known scraper/bot User-Agents before they reach app code.
        limit_conn conn_limit 20;

        if ($is_bad_bot) {
            return 403;
        }

        # ── Nest Auth Routes — extra rate limiting ────────────────────────────
        location = /api/auth/login {
            limit_req zone=auth_limit burst=5;
            proxy_pass http://$backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Pass cookies through (HttpOnly JWT)
            proxy_pass_header Set-Cookie;
        }

        location = /api/auth/register {
            limit_req zone=auth_limit burst=5;
            proxy_pass http://$backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass_header Set-Cookie;
        }

        location = /api/auth/logout {
            proxy_pass http://$backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass_header Set-Cookie;
        }

        location = /api/auth/refresh {
            proxy_pass http://$backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass_header Set-Cookie;
        }

        # Backend endpoint, and it must be listed explicitly: the /api/auth/
        # prefix below sends everything else to Next.js, which rewrites
        # /api/auth/newsletter straight back here - an infinite proxy loop.
        location = /api/auth/newsletter {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://$backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass_header Set-Cookie;
        }

        location = /api/auth/forgot-password {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://$backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass_header Set-Cookie;
        }

        location = /api/auth/reset-password {
            limit_req zone=api_limit burst=20 nodelay;
            proxy_pass http://$backend;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass_header Set-Cookie;
        }

        # ── Explicit NextAuth / Auth.js Routes ────────────────────────────────
        # These must stay on the frontend, not Nest.
        location ~ ^/api/auth/(error|signin|signout|session|csrf|providers|callback|verify-request) {
            proxy_pass http://$frontend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass_header Set-Cookie;
            proxy_cache_bypass $http_upgrade;
        }

        # ── NextAuth / Auth.js Routes ──────────────────────────────────────────
        location /api/auth/ {
            proxy_pass http://$frontend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass_header Set-Cookie;
            proxy_cache_bypass $http_upgrade;
        }

        # ── Chatbot API ────────────────────────────────────────────────────────
        location /api/chat {
            limit_req zone=chat_limit burst=5 nodelay;

            proxy_pass http://$backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout    60s;
            proxy_read_timeout    60s;
        }

        # ── Oil Finder: dropdown lookups (makes/models/generations/engines) ────
        # Cheap, Redis-cached reads. Generous ceiling so cascading dropdown UX
        # never feels throttled for a real user.
        location ~ ^/api/oil-finder/(makes|models) {
            limit_req zone=oilfinder_dropdown_limit burst=20 nodelay;

            proxy_pass http://$backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout    60s;
            proxy_read_timeout    60s;
            proxy_pass_header Set-Cookie;
        }

        # ── Oil Finder: vehicle/spec lookup ─────────────────────────────────────
        # Hits the DB and product-matching logic on every miss (not_found /
        # ambiguous results are deliberately never cached), so this is the
        # tightest non-auth tier — still well above real single-user usage.
        location ~ ^/api/oil-finder/(vehicle|specs) {
            limit_req zone=oilfinder_lookup_limit burst=6 nodelay;

            proxy_pass http://$backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout    60s;
            proxy_read_timeout    60s;
            proxy_pass_header Set-Cookie;
        }

        # ── Backend API ────────────────────────────────────────────────────────
        location /api/ {
            limit_req zone=api_limit burst=40 nodelay;

            proxy_pass http://$backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 60s;
            proxy_send_timeout    60s;
            proxy_read_timeout    60s;
            # Pass cookies through (HttpOnly JWT)
            proxy_pass_header Set-Cookie;
        }

        # ── Next.js Static Assets ──────────────────────────────────────────────
        location /_next/static/ {
            proxy_pass http://$frontend;
            expires 1y;
            add_header Cache-Control "public, max-age=31536000, immutable";
            access_log off;
        }

        # ── Public Media ───────────────────────────────────────────────────────
        location /media/ {
            proxy_pass http://$frontend;
            expires 30d;
            add_header Cache-Control "public, max-age=2592000";
            access_log off;
        }

        # ── Local Uploads (fallback when Cloudinary is not configured) ────────
        # Served directly from disk (nginx already has ./uploads mounted at
        # /srv/uploads) instead of proxying to the backend - cheaper than a
        # Node round-trip per image, and lets us serve a pre-generated .webp
        # sibling (see scripts/generate-webp-variants.sh) when the browser
        # supports it. Falls back to the original file, so this is a no-op for
        # any image that has no .webp variant yet.
        location /uploads/ {
            root /srv;
            try_files $uri$webp_suffix $uri =404;
            expires 30d;
            add_header Cache-Control "public, max-age=2592000";
            add_header Vary "Accept";
            # These files come from user uploads. The upload endpoints now
            # derive the stored extension from the validated MIME type, and
            # these headers are the second layer: no MIME sniffing, no inline
            # rendering, and a CSP that neuters any script that does slip in.
            add_header X-Content-Type-Options "nosniff" always;
            add_header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            access_log off;
        }

        location = /favicon.ico { proxy_pass http://$frontend; access_log off; }
        location = /robots.txt  { proxy_pass http://$frontend; access_log off; }

        # ── Block common scanner / WordPress probes ────────────────────────────
        location ~* ^/(en|fr)?/wp-(admin|login|content|includes) {
            deny all;
            return 444;
        }
        location ~* \.(php|asp|aspx|cgi|pl)$ {
            deny all;
            return 444;
        }

        # ── MinIO Object Storage (S3) ─────────────────────────────────────────
        # Images are served via /storage/ proxy. Listing is blocked at the
        # policy level in MinIO (s3:ListBucket is not granted). autoindex is
        # explicitly disabled here as a defense-in-depth measure.
        location /storage/ {
            # Same reasoning as /uploads/ - object storage holds user uploads.
            add_header X-Content-Type-Options "nosniff" always;
            add_header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox" always;
            add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
            proxy_pass http://minio:9000/;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            autoindex off;
            expires max;
            add_header Cache-Control "public, max-age=31536000, immutable";
            access_log off;
        }

        # ── Frontend ───────────────────────────────────────────────────────────
        location / {
            limit_req zone=site_limit burst=40 nodelay;

            proxy_pass http://$frontend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection 'upgrade';
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-Host $http_host;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass_header Set-Cookie;
            proxy_cache_bypass $http_upgrade;
        }
    }
}
