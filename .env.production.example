# ═══════════════════════════════════════════════════════════════════
# specpart — Production Environment Variables
# ═══════════════════════════════════════════════════════════════════
# INSTRUCTIONS:
#   1. Copy this file to .env on your Oracle VM: cp .env.production.example .env
#   2. Fill in every value below. Do NOT commit .env to git.
#   3. Ensure .env is in your .gitignore
# ═══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
NODE_ENV=production
DOMAIN=yourdomain.com
FRONTEND_URL=https://yourdomain.com
# Public URL the browser uses to reach the site and the API
NEXTAUTH_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=/api

# ── Database ──────────────────────────────────────────────────────
# Strong credentials — change these from the defaults!
POSTGRES_USER=specpart
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=specpart
DATABASE_URL=postgresql://specpart:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/specpart?schema=public

# ── Authentication ────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# ── Google OAuth (optional) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudinary (image uploads) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Sentry (error tracking) ───────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Resend (transactional email) ──────────────────────────────────
RESEND_API_KEY=

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Optional Upstash Redis (for rate limiting via Next.js API routes)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Backups (Oracle Object Storage) ──────────────────────────────
# S3-compatible Oracle Object Storage
BACKUP_S3_ENDPOINT=https://NAMESPACE.compat.objectstorage.REGION.oraclecloud.com
BACKUP_S3_BUCKET=specpart-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
