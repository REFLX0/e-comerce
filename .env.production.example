# ═══════════════════════════════════════════════════════════════════
# specpart — Production Environment Variables
# ═══════════════════════════════════════════════════════════════════
# INSTRUCTIONS:
#   1. Copy this file to .env on your VPS: cp .env.production.example .env
#   2. Fill in every value below. Do NOT commit .env to git.
#   3. Ensure .env is in your .gitignore
#
# CHANGING DOMAIN: set DOMAIN / FRONTEND_URL / NEXTAUTH_URL /
# NEXT_PUBLIC_SITE_URL to the new host, then REBUILD the frontend image
# (`docker compose build frontend`) — NEXT_PUBLIC_* values are inlined at build
# time, so restarting alone leaves canonical URLs, the sitemap, robots.txt and
# the legal pages pointing at the old domain. Issue the certificate for the new
# host before switching DOMAIN, or nginx will fail to start on a missing cert.
# ═══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
NODE_ENV=production
# Used for nginx server_name and the Let's Encrypt certificate path.
DOMAIN=yourdomain.com
FRONTEND_URL=https://yourdomain.com
# Public URL the browser uses to reach the site and the API
NEXTAUTH_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_NAME=specpart
# Shown in the footer; defaults to contact@<domain> when unset.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Database ──────────────────────────────────────────────────────
# Strong credentials — change these from the defaults!
POSTGRES_USER=specpart
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=specpart
DATABASE_URL=postgresql://specpart:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/specpart?schema=public
# Streaming replication read replica
DATABASE_REPLICA_URL=postgresql://specpart:CHANGE_ME_STRONG_DB_PASSWORD@db-replica:5432/specpart?schema=public
# Max Postgres connections held by the API. Note that connection_limit in the
# URL is ignored: this app uses the @prisma/adapter-pg driver adapter, so the
# pg Pool is what governs the pool size.
DATABASE_POOL_SIZE=10

# ── Kafka ─────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:9092

# ── Authentication ────────────────────────────────────────────────
# Generate each with: openssl rand -base64 64
# JWT_SECRET signs the backend access tokens and is shared by the API and the
# Next.js server (which mints a backend token for Google sign-ins). There is no
# fallback value — both refuse to start without it.
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# ── Google OAuth (optional) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Object storage (MinIO) ────────────────────────────────────────
# REQUIRED: docker-compose refuses to start without these. They were missing
# from this file, so a fresh VPS set up from it failed at `docker compose up`.
MINIO_ROOT_USER=CHANGE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
# Set MINIO_ENDPOINT in backend/.env to route uploads to MinIO instead of disk.

# ── Cloudinary (image uploads) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Sentry (error tracking) ───────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Brevo (transactional email) ───────────────────────────────────
BREVO_API_KEY=
# Sender / recipient addresses. Default to the historical gmail address when
# unset — set them so outgoing mail matches the current domain.
BREVO_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# Optional Upstash Redis (for rate limiting via Next.js API routes)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Backups (S3-compatible object storage) ───────────────────────
BACKUP_S3_ENDPOINT=https://NAMESPACE.compat.objectstorage.REGION.oraclecloud.com
BACKUP_S3_BUCKET=specpart-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
