// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "tecdoc"]
}

// ─────────────────────────────────────────
//  ENUMS (public schema)
// ─────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  PRO
  BLOCKED

  @@schema("public")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED

  @@schema("public")
}

enum OrderType {
  DELIVERY      // Placed through checkout, shipped to customer
  STORE_PICKUP  // Placed/collected in person at the boutique

  @@schema("public")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@schema("public")
}

enum CouponType {
  PERCENT
  FIXED
  SHIPPING

  @@schema("public")
}

enum TicketType {
  RETURN
  SUPPORT

  @@schema("public")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@schema("public")
}

enum VehicleType {
  AUTOMOBILE
  MOTO
  POIDS_LOURD
  AGRICOLE

  @@schema("public")
}

enum FuelType {
  ESSENCE
  DIESEL
  HYBRIDE
  ELECTRIQUE
  GPL

  @@schema("public")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED

  @@schema("public")
}

// ─────────────────────────────────────────
//  AUTHENTICATION & CORE USER (public schema)
// ─────────────────────────────────────────

model User {
  id                   String          @id @default(cuid())
  email                String          @unique
  name                 String?
  phone                String?
  passwordHash         String?
  role                 Role            @default(CUSTOMER)
  previousRole         Role?
  matriculeFisc        String?
  emailVerified        DateTime?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  image                String?
  accounts             Account[]
  sessions             Session[]
  addresses            Address[]
  orders               Order[]
  invoices             Invoice[]
  reviews              Review[]
  wishlist             WishlistItem[]
  cars                 UserCar[]
  tickets              SupportTicket[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@schema("public")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@schema("public")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@schema("public")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@schema("public")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  street     String?
  address    String?
  city       String
  wilaya     String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("public")
}

model UserCar {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String?
  make                 String
  makeSlug             String?
  model                String
  modelSlug            String?
  generation           String?
  year                 Int?
  engine               String?
  displacement         Float?
  cylinders            Int?
  fuel                 String?
  fuelType             String?
  power                Int?
  transmission         String?
  trim                 String?
  productionDate       String?
  vin                  String?
  registrationPlate    String?
  currentMileage       Int?
  annualMileage        Int?      @default(15000)
  lastOilChangeMileage Int?
  lastOilChangeDate    DateTime?
  oilChangeIntervalKm  Int?      @default(10000)
  oilFilterChanged     Boolean   @default(false)
  airFilterChanged     Boolean   @default(false)
  cabinFilterChanged   Boolean   @default(false)
  oilCapacity          Float?
  recommendedOilVisc   String?
  recommendedOilSpec   String?
  isDefault            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId, isDefault])
  @@schema("public")
}

// ─────────────────────────────────────────
//  COMMERCIAL CATALOGUE & INVENTORY (public schema)
// ─────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  nameFr    String
  slug      String     @unique
  imageUrl  String?
  sortOrder Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  @@schema("public")
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  logoUrl  String?
  products Product[]

  @@schema("public")
}

model Product {
  id               String                @id @default(cuid())
  sku              String                @unique
  nameFr           String
  slug             String                @unique
  description      String                @db.Text
  isFeatured       Boolean               @default(false)
  isPublished      Boolean               @default(true)
  brandId          String?
  brand            Brand?                @relation(fields: [brandId], references: [id])
  categoryId       String?
  category         Category?             @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  specs            ProductSpecs?
  sourcing         ProductSourcing?
  compatibilities  VehicleCompatibility[]
  orderItems       OrderItem[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  createdAt        DateTime              @default(now())

  @@schema("public")
}

model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  volume          String      // e.g., "1L", "5L", "1 Pièce"
  price           Float       // Selling price TTC
  costPrice       Float?      // Purchase price from supplier
  stockQty        Int         @default(0)
  skuVariant      String      @unique
  tecdocArticleId Int?        @unique // Direct link to tecdoc.articles.id
  supplierName    String?     // Name of local supplier/grossiste
  warehouse       String?     // Location/bin in warehouse e.g. "A-04"
  imageUrl        String?
  orderItems      OrderItem[]

  @@schema("public")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altFr     String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  @@schema("public")
}

model ProductSpecs {
  id               String        @id @default(cuid())
  productId        String        @unique
  product          Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  viscosity        String?
  apiStandard      String?
  aeceaStandard    String?
  jasoStandard     String?
  isFullySynth     Boolean       @default(false)
  isSemiSynth      Boolean       @default(false)
  isMinerale       Boolean       @default(false)
  DPFCompatible    Boolean?
  TurboCompatible  Boolean?
  HybridCompatible Boolean?
  OEMApprovals     String?
  vehicleTypes     VehicleType[]
  fuelTypes        FuelType[]
  minCylinders     Int?
  maxCylinders     Int?
  minPower         Float?
  maxPower         Float?

  @@schema("public")
}

model VehicleMake {
  id       String         @id @default(cuid())
  name     String         @unique
  slug     String         @unique
  models   VehicleModel[]

  @@schema("public")
}

model VehicleModel {
  id              String                 @id @default(cuid())
  makeId          String
  make            VehicleMake            @relation(fields: [makeId], references: [id], onDelete: Cascade)
  vehicleType     VehicleType            @default(AUTOMOBILE)
  name            String
  slug            String                 @unique
  compatibilities VehicleCompatibility[]

  @@schema("public")
}

model VehicleCompatibility {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  engineCode     String?
  yearFrom       Int?
  yearTo         Int?

  @@unique([productId, vehicleModelId, engineCode])
  @@schema("public")
}

model ProductSourcing {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceUrl         String?
  sourceTitle       String?
  evidence          String?  @db.Text
  derivedValueNotes String?  @db.Text
  confidence        String
  createdAt         DateTime @default(now())

  @@schema("public")
}

model UnmatchedVehicleQuery {
  id                    String   @id @default(cuid())
  make                  String
  model                 String
  engineCode            String?
  yearFrom              Int?
  yearTo                Int?
  requiredSpecification String?
  source                String   @default("user_search")
  resolved              Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@index([make, model, engineCode, createdAt])
  @@schema("public")
}

// ─────────────────────────────────────────
//  OIL FINDER — STAGING & CAPACITIES (public schema)
// ─────────────────────────────────────────

model OilFinderOilSpec {
  id               String             @id @default(cuid())
  viscosity        String
  apiStandard      String?
  aceaStandard     String?
  oemApproval      String?
  capacityLiters   Float?
  changeIntervalKm Int?
  fingerprint      String             @unique
  vehicles         OilFinderVehicle[]

  @@schema("public")
}

model OilFinderVehicle {
  id                           String           @id @default(cuid())
  make                         String
  model                        String
  category                     String           @default("automobile")
  generation                   String           @default("")
  yearFrom                     Int?
  yearTo                       Int?
  engineCode                   String           @default("")
  displacementCc               Int?
  powerKw                      Float?
  powerHp                      Float?
  fuelType                     String
  oilSpecId                    String
  oilSpec                      OilFinderOilSpec @relation(fields: [oilSpecId], references: [id], onDelete: Restrict)
  source                       String
  confidence                   String
  matchAmbiguity               Json?
  hydraulicTransmissionOilType String?
  hydraulicOilSpecOEM          String?
  hydraulicOilCapacityLiters   Float?

  @@unique([make, model, generation, engineCode, source])
  @@index([make, model, engineCode])
  @@index([displacementCc, powerHp, fuelType])
  @@schema("public")
}

model OilFinderLookupConflict {
  id              String @id @default(cuid())
  displacementCc  Int
  powerHp         Float
  fuelType        String
  highestSeverity String
  fieldSeverities Json
  candidateCount  Int
  rawReport       Json?

  @@unique([displacementCc, powerHp, fuelType])
  @@schema("public")
}

// ─────────────────────────────────────────
//  ORDERS, BILLING & CUSTOMERS (public schema)
// ─────────────────────────────────────────

model Order {
  id             String          @id @default(cuid())
  userId         String?
  user           User?           @relation(fields: [userId], references: [id])
  status         OrderStatus     @default(PENDING)
  orderType      OrderType       @default(DELIVERY)
  totalAmount    Float
  shippingCost   Float           @default(0)
  promoCode      String?
  idempotencyKey String?         @unique
  shipFullName   String
  shipPhone      String
  shipWilaya     String
  shipCity       String
  vehicleVin     String?
  notes          String?
  items          OrderItem[]
  supportTickets SupportTicket[]
  payments       Payment[]
  invoice        Invoice?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, createdAt])
  @@schema("public")
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  variantId       String
  variant         ProductVariant  @relation(fields: [variantId], references: [id])
  tecdocArticleId Int?            // Snapshot of TecDoc Article ID
  quantity        Int
  unitPrice       Float           // Snapshot of price at time of purchase

  @@schema("public")
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  rating     Int
  comment    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("public")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@schema("public")
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Float
  minAmount   Float?
  maxUses     Int?
  currentUses Int        @default(0)
  expiryDate  DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@schema("public")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@schema("public")
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type      TicketType
  reason    String
  message   String?      @db.Text
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@schema("public")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        String        @default("COD")
  amount        Float
  status        PaymentStatus @default(PENDING)
  transactionId String?
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@schema("public")
}

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  price     Float
  eta       String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model ContactMessage {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String?
  subject        String
  message        String   @db.Text
  isProfessional Boolean  @default(false)
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@schema("public")
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model Invoice {
  id             String        @id @default(cuid())
  sequenceNumber Int           @unique @default(autoincrement())
  invoiceNumber  String        @unique
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  status         InvoiceStatus @default(DRAFT)
  customerId     String?
  customer       User?         @relation(fields: [customerId], references: [id])
  orderId        String?       @unique
  order          Order?        @relation(fields: [orderId], references: [id])
  clientName     String
  clientAddress  String?
  clientEmail    String?
  clientPhone    String?
  clientMf       String?
  notes          String?       @db.Text
  subtotalHT     Float
  totalTVA       Float
  totalTTC       Float
  amountInWords  String        @db.Text
  lines          InvoiceLine[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@schema("public")
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPriceHT Float
  vatRate     Float    @default(0.19)
  vatAmount   Float
  totalTTC    Float

  @@schema("public")
}

// ─────────────────────────────────────────
//  TECDOC REFERENCE MODELS (tecdoc schema)
// ─────────────────────────────────────────

model TecdocSupplier {
  id                   Int       @id
  internalId           Int?      @map("internal_id")
  dataVersion          Int?      @map("data_version")
  matchcode            String?   @db.VarChar(255)
  nbrOfArticles        Int?      @map("nbr_of_articles")
  hasNewVersionArticles Boolean?  @map("has_new_version_articles")
  description          String?   @db.Text

  @@map("suppliers")
  @@schema("tecdoc")
}

model TecdocProduct {
  id                       Int     @id
  internalId               Int?    @map("internal_id")
  normalizedDescription    String? @map("normalized_description") @db.VarChar(255)
  assemblyGroupDescription String? @map("assembly_group_description") @db.VarChar(255)
  usageDescription         String? @map("usage_description") @db.VarChar(255)
  description              String? @db.VarChar(255)

  @@map("products")
  @@schema("tecdoc")
}

model TecdocManufacturer {
  id                   Int      @id
  matchcode            String?  @db.VarChar(255)
  isVgl                Boolean? @map("is_vgl")
  description          String?  @db.VarChar(255)
  isPassengerCar       Boolean? @default(false) @map("is_passenger_car")
  isCommercialVehicle  Boolean? @default(false) @map("is_commercial_vehicle")
  isEngine             Boolean? @default(false) @map("is_engine")
  isMotorbike          Boolean? @default(false) @map("is_motorbike")
  isAxle               Boolean? @default(false) @map("is_axle")
  isTransporter        Boolean? @default(false) @map("is_transporter")
  isCvManufacturerId   Boolean? @default(false) @map("is_cv_manufacturer_id")
  canBeDisplayed       Boolean? @default(true) @map("can_be_displayed")

  @@map("manufacturers")
  @@schema("tecdoc")
}

model TecdocModel {
  id                     Int       @id
  manufacturerId         Int?      @map("manufacturer_id")
  dateFrom               DateTime? @map("date_from") @db.Date
  dateTo                 DateTime? @map("date_to") @db.Date
  description            String?   @db.Text
  canBeDisplayed         Boolean?  @default(true) @map("can_be_displayed")
  isPassengerCar         Boolean?  @default(false) @map("is_passenger_car")
  isCommercialVehicle    Boolean?  @default(false) @map("is_commercial_vehicle")
  isEngine               Boolean?  @default(false) @map("is_engine")
  isMotorbike            Boolean?  @default(false) @map("is_motorbike")
  isAxle                 Boolean?  @default(false) @map("is_axle")
  isTransporter          Boolean?  @default(false) @map("is_transporter")
  isCvManufacturerId     Boolean?  @default(false) @map("is_cv_manufacturer_id")
  hasLink                Boolean?  @default(false) @map("has_link")
  isValidForCurrentCountry Boolean? @default(true) @map("is_valid_for_current_country")

  @@map("models")
  @@schema("tecdoc")
}

model TecdocPassengerCar {
  id                   Int       @id
  internalId           Int?      @map("internal_id")
  modelId              Int?      @map("model_id")
  manufacturerMatchcode String?  @map("manufacturer_matchcode") @db.VarChar(255)
  manufacturerId       Int?      @map("manufacturer_id")
  dateFrom             DateTime? @map("date_from") @db.Date
  dateTo               DateTime? @map("date_to") @db.Date
  description          String?   @db.Text
  fullDescription      String?   @map("full_description") @db.VarChar(255)
  canBeDisplayed       Boolean?  @default(true) @map("can_be_displayed")

  @@map("passengercars")
  @@schema("tecdoc")
}

model TecdocEngine {
  id               Int       @id
  internalId       Int?      @map("internal_id")
  manufacturer     Int?
  salesDescription String?   @map("sales_description") @db.Text
  hasLinkitem      Boolean?  @default(false) @map("has_linkitem")
  description      String?   @db.Text
  dateFrom         DateTime? @map("date_from") @db.Date
  dateTo           DateTime? @map("date_to") @db.Date
  canBeDisplayed   Boolean?  @default(true) @map("can_be_displayed")

  @@map("engines")
  @@schema("tecdoc")
}

model TecdocArticle {
  id                         Int      @id
  dataSupplierArticleNumber  String   @map("data_supplier_article_number") @db.VarChar(255)
  supplier                   Int
  currentProduct             Int?     @map("current_product")
  normalizedDescription      String?  @map("normalized_description") @db.Text
  hasLinkitems               Boolean? @default(false) @map("has_linkitems")
  hasPassengerCar            Boolean? @default(false) @map("has_passenger_car")
  hasCommercialVehicle       Boolean? @default(false) @map("has_commercial_vehicle")
  hasMotorbike               Boolean? @default(false) @map("has_motorbike")
  hasEngine                  Boolean? @default(false) @map("has_engine")
  hasAxle                    Boolean? @default(false) @map("has_axle")
  hasCvManuId                Boolean? @default(false) @map("has_cv_manu_id")
  lotSize1                   Int?     @map("lot_size1")
  lotSize2                   Int?     @map("lot_size2")
  flagMaterialCertification  Boolean? @default(false) @map("flag_material_certification")
  flagSelfServicePacking     Boolean? @default(false) @map("flag_self_service_packing")
  flagRemanufactured         Boolean? @default(false) @map("flag_remanufactured")
  flagAccessory              Boolean? @default(false) @map("flag_accessory")
  isPseudoArticle            Boolean? @default(false) @map("is_pseudo_article")
  isValid                    Boolean? @default(true) @map("is_valid")
  description                String?  @db.Text
  articleStateAttributeGroup String?  @map("article_state_attribute_group") @db.VarChar(255)
  articleStateAttributeType  String?  @map("article_state_attribute_type") @db.VarChar(255)
  articleStateDisplayTitle   String?  @map("article_state_display_title") @db.VarChar(255)
  articleStateDisplayValue   String?  @map("article_state_display_value") @db.VarChar(255)
  packingUnit                Int?     @map("packing_unit")
  quantityPerPackingUnit     Int?     @map("quantity_per_packing_unit")

  @@map("articles")
  @@schema("tecdoc")
}

model TecdocSearchTree {
  treeId       Int     @map("tree_id")
  nodeId       Int     @map("node_id")
  parentNodeId Int?    @map("parent_node_id")
  description  String? @db.VarChar(255)

  @@id([treeId, nodeId])
  @@map("search_trees")
  @@schema("tecdoc")
}
