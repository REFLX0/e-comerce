// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  PRO
  BLOCKED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderType {
  DELIVERY      // Placed through checkout, shipped to customer
  STORE_PICKUP  // Placed/collected in person at the boutique
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
  SHIPPING
}

enum TicketType {
  RETURN
  SUPPORT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum VehicleType {
  AUTOMOBILE
  MOTO
  POIDS_LOURD
  AGRICOLE
}

enum FuelType {
  ESSENCE
  DIESEL
}

// ─────────────────────────────────────────
//  AUTH (NextAuth v5 required tables)
// ─────────────────────────────────────────

model User {
  id                   String     @id @default(cuid())
  name                 String?
  email                String     @unique
  emailVerified        DateTime?
  image                String?
  passwordHash         String?
  role                 Role       @default(CUSTOMER)
  previousRole         Role?
  phone                String?
  resetPasswordToken   String?    @unique
  resetPasswordExpires DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  accounts              Account[]
  sessions              Session[]
  addresses             Address[]
  cars                  UserCar[]
  orders                Order[]
  reviews               Review[]
  wishlistItems         WishlistItem[]
  supportTickets        SupportTicket[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────
//  ADDRESSES
// ─────────────────────────────────────────

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  address   String?
  city      String
  wilaya    String
  postalCode String?
  isDefault Boolean @default(false)
}

// ─────────────────────────────────────────
//  CUSTOMER CARS / VIDANGE REMINDERS
// ─────────────────────────────────────────

model UserCar {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  make                 String?   // display name e.g. "Renault" — used for compatibility matching
  model                String?   // display name e.g. "Clio IV" — used for compatibility matching
  makeSlug             String?   // slug e.g. "renault" — used for catalogue URL filter
  modelSlug            String?   // slug e.g. "clio-iv" — used for catalogue URL filter
  year                 Int?
  vin                  String?   // 17-character VIN / chassis number
  engine               String?   // motorisation e.g. "1.5 dCi 90" — used for compatibility matching
  displacement         Float?    // cylinder capacity in litres e.g. 1.2, 1.5, 2.0
  cylinders            Int?      // number of cylinders e.g. 3, 4, 6
  fuel                 String?   // "essence" | "diesel" | "hybride" | "electrique" | "gpl"
  power                Float?    // horsepower e.g. 90
  transmission         String?   // "manuelle" | "automatique"
  trim                 String?   // version / finition e.g. "Zen", "GT-Line"
  productionDate       String?   // "YYYY-MM" production month/year
  currentMileage       Int       @default(0)
  lastOilChangeMileage Int       @default(0)
  oilChangeIntervalKm  Int       @default(10000)
  oilChangeDone        Boolean   @default(false)
  oilFilterChanged     Boolean   @default(false)
  airFilterChanged     Boolean   @default(false)
  cabinFilterChanged   Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────
//  CATALOG
// ─────────────────────────────────────────

model Category {
  id        String     @id @default(cuid())
  nameFr    String
  slug      String     @unique
  imageUrl  String?
  sortOrder Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  logoUrl  String?
  products Product[]
}

model Product {
  id               String                @id @default(cuid())
  sku              String                @unique
  nameFr           String
  slug             String                @unique
  description      String                @db.Text
  isFeatured       Boolean               @default(false)
  isPublished      Boolean               @default(true)
  brandId          String
  brand            Brand                 @relation(fields: [brandId], references: [id])
  categoryId       String
  category         Category              @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  specs            ProductSpecs?
  sourcing         ProductSourcing?
  compatibilities  VehicleCompatibility[]
  orderItems       OrderItem[]
  reviews          Review[]
  wishlistItems    WishlistItem[]
  createdAt        DateTime              @default(now())
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  volume     String      // e.g., "1L", "5L", "208L"
  price      Float
  stockQty   Int         @default(0)
  skuVariant String      @unique
  imageUrl   String?     // variant-specific image (different bottles per volume)
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altFr     String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)
}

// Oil technical specs (viscosity, API standard, etc.)
model ProductSpecs {
  id               String      @id @default(cuid())
  productId        String      @unique
  product          Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  viscosity        String?     // e.g., "5W-40"
  apiStandard      String?     // e.g., "API SN"
  aeceaStandard    String?     // e.g., "ACEA C3"
  jasoStandard     String?     // e.g., "MA2", "MA", "MB" — motorcycle wet-clutch JASO grade
  isFullySynth     Boolean     @default(false)
  isSemiSynth      Boolean     @default(false)
  isMinerale       Boolean     @default(false)
  DPFCompatible    Boolean?
  TurboCompatible  Boolean?
  HybridCompatible Boolean?
  OEMApprovals     String?     // e.g., "BMW LL-04; MB 229.51"
  vehicleTypes     VehicleType[]
  fuelTypes        FuelType[]
  minCylinders     Int?
  maxCylinders     Int?
  minPower         Float?
  maxPower         Float?
}

// ─────────────────────────────────────────
//  "TROUVER MON HUILE" CONFIGURATOR
// ─────────────────────────────────────────

model VehicleMake {
  id       String         @id @default(cuid())
  name     String         @unique // e.g., "Renault"
  slug     String         @unique
  models   VehicleModel[]
}

model VehicleModel {
  id             String               @id @default(cuid())
  makeId         String
  make           VehicleMake          @relation(fields: [makeId], references: [id], onDelete: Cascade)
  vehicleType    VehicleType @default(AUTOMOBILE)
  name           String               // e.g., "Clio IV"
  slug           String               @unique
  compatibilities VehicleCompatibility[]
}

model VehicleCompatibility {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleModelId String
  vehicleModel  VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  engineCode    String?      // e.g., "1.5 dCi 90"
  yearFrom      Int?
  yearTo        Int?

  @@unique([productId, vehicleModelId, engineCode])
}

// Administrative provenance for imported lubricant specifications.  This is
// deliberately kept separate from the customer-facing product data.
model ProductSourcing {
  id                String   @id @default(cuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceUrl         String?
  sourceTitle       String?
  evidence          String?  @db.Text
  derivedValueNotes String?  @db.Text
  confidence        String
  createdAt         DateTime @default(now())
}

// Captures unsupported vehicle searches so the catalogue team can source the
// corresponding specifications later.
model UnmatchedVehicleQuery {
  id                    String   @id @default(cuid())
  make                  String
  model                 String
  engineCode            String?
  yearFrom              Int?
  yearTo                Int?
  requiredSpecification String?
  source                String   @default("user_search")
  resolved              Boolean  @default(false)
  createdAt             DateTime @default(now())

  @@index([make, model, engineCode, createdAt])
}

// ─────────────────────────────────────────
//  OIL FINDER — STAGING DATASET
//  Vehicle→oil specification lookup data imported from the verified
//  automobile-{brand}.json files + characteristics-lookup-conflicts.json.
//  Kept separate from the catalogue (ProductSpecs) and the product
//  compatibility matcher (VehicleMake/VehicleModel/VehicleCompatibility).
// ─────────────────────────────────────────

model OilFinderOilSpec {
  id               String             @id @default(cuid())
  viscosity        String // e.g. "5W-40"
  apiStandard      String? // e.g. "API SN"
  aceaStandard     String? // e.g. "ACEA A3/B4"
  oemApproval      String? // e.g. "VW 502.00"
  capacityLiters   Float? // from oilCapacityLiters
  changeIntervalKm Int? // from oilChangeIntervalKm
  fingerprint      String             @unique // canonical key: normalized JSON of (viscosity|api|acea|oem)
  vehicles         OilFinderVehicle[]
}

model OilFinderVehicle {
  id              String             @id @default(cuid())
  make            String
  model           String
  category        String             @default("automobile")
  generation      String             @default("") // "" = not specified (keeps the natural key non-null → idempotent import)
  yearFrom        Int?
  yearTo          Int?
  engineCode      String             @default("") // "" = not specified
  displacementCc  Int?
  powerKw         Float?
  powerHp         Float?
  fuelType        String // String, not the ESSENCE/DIESEL enum — staging may hold hybride/gpl
  oilSpecId       String
  oilSpec         OilFinderOilSpec   @relation(fields: [oilSpecId], references: [id], onDelete: Restrict)
  source          String // provenance, preserved for support/audit
  confidence      String // "high" | "medium" | "low" — preserved, queryable
  matchAmbiguity  Json? // null | { field: "major"|"minor" } — verbatim from input

  // Hydraulic fluid fields (specifically for agricole category)
  hydraulicTransmissionOilType  String?
  hydraulicOilSpecOEM           String?
  hydraulicOilCapacityLiters    Float?

  @@unique([make, model, generation, engineCode, source]) // same vehicle from N sources = N rows
  @@index([make, model, engineCode])
  @@index([displacementCc, powerHp, fuelType])
}

model OilFinderLookupConflict {
  id              String @id @default(cuid())
  displacementCc  Int
  powerHp         Float
  fuelType        String
  highestSeverity String // "MAJOR" | "MINOR" (derived: any major field → MAJOR)
  fieldSeverities Json // { oilViscosity: "major", ... } — verbatim from report
  candidateCount  Int
  rawReport       Json? // full report line, for audit

  @@unique([displacementCc, powerHp, fuelType])
}

// ─────────────────────────────────────────
//  ORDERS
// ─────────────────────────────────────────

model Order {
  id             String      @id @default(cuid())
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  status         OrderStatus @default(PENDING)
  orderType      OrderType   @default(DELIVERY)
  totalAmount    Float
  shippingCost   Float       @default(0)
  promoCode      String?
  idempotencyKey String?     @unique
  // Shipping snapshot (denormalized for data integrity)
  shipFullName   String
  shipPhone      String
  shipWilaya     String
  shipCity       String
  vehicleVin     String?
  notes          String?
  items          OrderItem[]
  supportTickets SupportTicket[]
  payments       Payment[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Float          // Snapshot of price at time of purchase
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName  String
  rating      Int
  comment     String
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────
//  NOTIFICATIONS (Admin)
// ─────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  type      String   // "new_order" | "low_stock" | "new_review" | "new_ticket"
  title     String
  message   String?
  link      String?  // relative admin URL e.g. "/admin/orders/xxx"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────
//  COUPONS
// ─────────────────────────────────────────

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Float      // Percentage (e.g. 20 = 20%) or fixed TND amount
  minAmount   Float?     // Minimum cart total to apply coupon
  maxUses     Int?
  currentUses Int        @default(0)
  expiryDate  DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ─────────────────────────────────────────
//  WISHLIST
// ─────────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ─────────────────────────────────────────
//  SUPPORT TICKETS
// ─────────────────────────────────────────

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type      TicketType
  reason    String
  message   String?      @db.Text
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// ─────────────────────────────────────────
//  PAYMENTS
// ─────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method        String        @default("COD") // "COD", "CREDIT_CARD", etc.
  amount        Float
  status        PaymentStatus @default(PENDING)
  transactionId String?       // Optional: ID from a payment gateway
  notes         String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// ─────────────────────────────────────────
//  SHIPPING ZONES
// ─────────────────────────────────────────

model ShippingZone {
  id        String   @id @default(cuid())
  name      String
  price     Float
  eta       String   // e.g. "24-48h"
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────
//  CONTACT MESSAGES
// ─────────────────────────────────────────

model ContactMessage {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String?
  subject        String
  message        String   @db.Text
  isProfessional Boolean  @default(false)
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────
//  SETTINGS
// ─────────────────────────────────────────

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., "SITE_NAME", "CONTACT_EMAIL", "COD_ENABLED"
  value     String   @db.Text // Stored as JSON strings to support booleans, numbers, etc.
  updatedAt DateTime @updatedAt
}
